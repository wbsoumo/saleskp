# ==========================================================
# Security Rules for Uploads Directory
# Disallow direct execution of scripts
# ==========================================================

<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|phps|pl|py|cgi|sh|bash|exe)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

Options -Indexes -ExecCGI
